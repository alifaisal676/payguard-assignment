# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python / virtual environments -----------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Jupyter ---------------------------------------------------------------
.ipynb_checkpoints/

# --- Data (downloaded or generated; recreate with the scripts) -------------
# Part A: creditcard.csv is ~150 MB, download per README
part_a_fraud/data/*
!part_a_fraud/data/.gitkeep
# Part B: the raw slice (~1 MB, public, CFPB-redacted) and triage outputs ARE committed.
# CFPB withdrew narratives from its API in Aug 2026, so re-downloading may not stay possible.
# The per-call debug log is not committed.
part_b_triage/data/*
!part_b_triage/data/.gitkeep
!part_b_triage/data/complaints_raw.json
!part_b_triage/data/triage_outputs__*.jsonl
!part_b_triage/data/run_log.jsonl
# Large/binary data anywhere in the repo
*.csv
*.parquet
*.zip
*.pkl
*.joblib
# Hand labels ARE committed (they're the evaluation set)
!part_b_triage/labels/*.csv

# --- Logs & outputs --------------------------------------------------------
*.log
logs/

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
