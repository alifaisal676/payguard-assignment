# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python / virtual environments -----------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Jupyter ---------------------------------------------------------------
.ipynb_checkpoints/

# --- Data (downloaded or generated; recreate with the scripts) -------------
