# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM provider Part B uses: groq | gemini | ollama
LLM_PROVIDER=groq

# Groq (primary) - free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (optional) - key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (optional, local - data never leaves the machine)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
